# GitLab CE 이미지 태그 — `latest` 금지
# 고객(우리금융지주) EKS Helm Chart appVersion과 동일한 CE 태그로 핀
# 예: 17.8.2-ce.0  (https://hub.docker.com/r/gitlab/gitlab-ce/tags)
GITLAB_IMAGE_TAG=

# GitLab 호스트 이름 (컨테이너 hostname; 사용자 접근 URL은 GITLAB_EXTERNAL_URL)
GITLAB_HOSTNAME=gitlab.local

# 외부 URL — 브라우저/Git 클라이언트가 사용할 주소
# 포트가 80이 아닌 경우 반드시 포트까지 명시해야 함
# 사내 개발서버 배포 시: localhost 대신 실제 접근 가능한 호스트로 변경
# 예: http://devserver.example.local:48080
GITLAB_EXTERNAL_URL=http://localhost:48080

# 호스트 측 포트 매핑 (호스트 포트:컨테이너 포트)
# 일반적인 8080/8443/2222 대신 충돌 가능성이 낮은 48xxx 대역 사용
# (k8s NodePort 30000~32767 범위도 피함)
GITLAB_HTTP_PORT=48080
GITLAB_HTTPS_PORT=48443
GITLAB_SSH_PORT=48022

# 초기 root 비밀번호 (최초 1회만 적용됨; 이후엔 컨테이너 내에서 변경)
# 사내 개발서버라도 기본/약한 비밀번호 사용 금지 — 12자 이상 + 특수문자
GITLAB_ROOT_PASSWORD=
